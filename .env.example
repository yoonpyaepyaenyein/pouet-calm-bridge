# Copy the variable names into the Vercel project settings; never commit values.

# Instances the bridge may contact. Each id needs its own host and bot token,
# and an instance whose pair is missing is simply unavailable.
CALM_INSTANCES=pouet
CALM_POUET_HOST=pouetfrance.social
# An access token for the bot account, with write:statuses scope.
CALM_POUET_BOT_TOKEN=

# The model that writes the calming reply.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Added automatically when a Redis (Upstash) store is attached to the project.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional fact-check step (lib/factcheck.js).
# off (default), log (search and record for review, reply unchanged) or on.
FACTCHECK_MODE=
# Comma separated sites to search, a path narrows a site to one section, e.g.
# ouest-france.fr,factuel.afp.com,lemonde.fr/les-decodeurs
# Leave empty for the built-in list.
FACTCHECK_DOMAINS=
# Models for the two small fact-check calls. Mistral's rate limit is per model,
# so they default to other models than the reply (MISTRAL_MODEL).
FACTCHECK_CLAIM_MODEL=
FACTCHECK_LINE_MODEL=
# The source sentence when the thread is not in French (it translates too).
FACTCHECK_TRANSLATED_LINE_MODEL=
# Serper (serper.dev) search API key. Only a short query of plain words is sent.
SERPER_API_KEY=
